# Copiá este archivo a .env y ajustá lo que quieras.
# docker-compose lo toma automáticamente.
#
# En PRODUCCIÓN no hace falta copiarlo a mano: prod.sh crea el .env con una
# contraseña de base de datos segura si todavía no existe.

# --- Base de datos (Postgres) ---
POSTGRES_USER=figus
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=figus

# --- Admin / Telemetría ---
# Clave para entrar al menú de Admin (se abre tocando la versión en el pie de la
# app). Muestra métricas agregadas de la comunidad. Si queda vacío, el panel de
# admin queda deshabilitado. En producción, prod.sh genera una clave segura.
ADMIN_TOKEN=cambiame-admin

# --- Desarrollo local ---
# Puerto para abrir la web en tu máquina (http://localhost:WEB_PORT).
# Solo aplica en desarrollo (docker compose up). En producción no se publica
# ningún puerto: la app se expone por Cloudflare Tunnel.
WEB_PORT=8080

# --- Cloudflare Tunnel (opcional, para producción) ---
# Pegá el token de tu tunnel de Cloudflare. Si está seteado, prod.sh levanta
# también el servicio cloudflared, que conecta el túnel a web:3000 sin abrir
# puertos. En el panel de Cloudflare, apuntá el hostname público a http://web:3000.
# TUNNEL_TOKEN=
